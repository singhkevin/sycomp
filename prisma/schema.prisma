// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum POStatus {
  OPEN
  IN_PROCESS
  CLOSED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      Role     @default(USER)
  country   String?
  otpCode   String?
  otpExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  cart      Cart?
  orders    Order[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  products  Product[]
}

model Product {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  description        String?
  price              Float
  imageUrl           String?
  countryRestrictions String[] // Array of country codes e.g. ["US", "CA"]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  categoryId         String
  category           Category @relation(fields: [categoryId], references: [id])
  
  inventory          Inventory?
  cartItems          CartItem[]
  orderItems         OrderItem[]
}

model Inventory {
  id             String   @id @default(cuid())
  quantity       Int      @default(0)
  lowStockAlert  Int      @default(5)
  
  productId      String   @unique
  product        Product  @relation(fields: [productId], references: [id])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  
  items     CartItem[]
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id])
  
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  total     Float
  status    String   @default("PENDING") // e.g. PENDING, PAID, SHIPPED, DELIVERED
  createdAt DateTime @default(now())
  
  items     OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model PurchaseOrder {
  id        String   @id @default(cuid())
  poNumber  String   @unique
  status    POStatus @default(OPEN)
  total     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
