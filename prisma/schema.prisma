// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum POStatus {
  OPEN
  IN_PROCESS
  CLOSED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      Role     @default(USER)
  country   String?
  otpCode   String?
  otpExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  cart      Cart?
  orders    Order[]
  purchaseOrders PurchaseOrder[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  
  markets     ProductMarket[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model ProductMarket {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  country    String   // e.g. "IN", "AU"
  price      Float
  sku        String?
  
  inventory  Inventory?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, country])
}

model Inventory {
  id             String   @id @default(cuid())
  quantity       Int      @default(0)
  lowStockAlert  Int      @default(5)
  
  productMarketId String   @unique
  productMarket   ProductMarket @relation(fields: [productMarketId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  
  items     CartItem[]
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id])
  
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  
  marketId  String?  // Optional for now to maintain compatibility
  country   String   @default("US")
  
  quantity  Int      @default(1)
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  total     Float
  country   String   @default("US")
  status    String   @default("PENDING") // e.g. PENDING, PAID, SHIPPED, DELIVERED
  createdAt DateTime @default(now())
  
  items     OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  marketId  String?
  quantity  Int
  price     Float
}

model PurchaseOrder {
  id        String   @id @default(cuid())
  poNumber  String   @unique
  status    POStatus @default(OPEN)
  total     Float
  country   String   @default("US")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  items     PurchaseOrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  
  productName     String
  quantity        Int
  unitPrice       Float
  totalPrice      Float
}
